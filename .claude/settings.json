{
    "$schema": "https://json.schemastore.org/claude-code-settings.json",
    "permissions": {
        "deny": [
            "Read(.env)",
            "Read(.env.*)",
            "Read(!.env.example)",
            "Edit(/.claude/settings.json)",
            "Bash(git push *--force*)",
            "Bash(git push -f*)",
            "Bash(git push * -f)",
            "Bash(git push * -f *)",
            "Bash(git push *+*)",
            "Bash(git push *--no-verify*)",
            "Bash(git commit *--no-verify*)",
            "Bash(git commit -n*)",
            "Bash(git reset --hard*)",
            "Bash(git clean -f*)"
        ],
        "ask": [
            "Edit(/.husky/**)",
            "Edit(/.github/workflows/**)",
            "Edit(/.github/ruleset.json)",
            "Edit(/scripts/gate-tiers.json)",
            "Edit(/stryker.config.json)",
            "Edit(/.npmrc)"
        ]
    }
}
