# Staged-scope pass: autofix and re-stage what is actually being committed.
#
# Guarded and pinned, for the same reason the TDD gate below is guarded. `--no-install`
# stops npx fetching a different lint-staged from the network when node_modules is
# incomplete — a gate that runs a tool the repo does not pin is not a gate. And the
# explicit `if !` does not lean on husky's `sh -e`: relying on an implicit errexit here
# is one refactor away from a swallowed failure, which lands a commit with no autofix at
# all and only looks harmless because the repo-scope pass below usually fails too.
if ! npx --no-install lint-staged; then
    echo ""
    echo "✖ The staged-file autofix failed. Fix the reported files first."
    echo "  One remedy, then stage:  npm run fix && git add -u"
    exit 1
fi

# TDD-gate: staged src logic files must have a co-located *.test.* sibling.
# Guarded explicitly rather than leaning on husky's `sh -e`: an implicit errexit
# is one refactor away from turning this into a fail-open check.
node scripts/check-test-siblings.mjs || exit 1

# Repo-scope pass. lint-staged only touches STAGED files, and for a partially
# staged file it restores the unstaged hunks AFTER fixing — so formatting drift
# can survive a commit and then fail the push gate. That is how "already fixed
# but never committed" files end up dangling in the tree. Catch it here, while
# the remedy is still one command, instead of after the commit exists.
#
# oxlint is repo-wide because it costs well under a second. ESLint is type-aware
# and slow, so it stays on pre-push with the rest of the gate.
# Both checks run even when the first one fails, so one commit attempt reports
# everything that needs fixing instead of sending you round twice.
repo_gate_status=0
npm run lint:oxlint || repo_gate_status=1
npm run format:check || repo_gate_status=1

if [ "$repo_gate_status" -ne 0 ]; then
    echo ""
    echo "✖ Repo-wide oxlint or formatting failed, outside the staged set."
    echo "  Autofix and stage it in one step:  npm run fix && git add -u"
    exit 1
fi
