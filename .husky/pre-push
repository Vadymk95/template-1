# Optional nvm version switch (.nvmrc). Fenced with set +e: husky runs hooks
# under `sh -e`, and nvm re-arms errexit internally before returning non-zero —
# without the fence a missing nvm version kills the hook before its real work.
export NVM_DIR="${NVM_DIR:-$HOME/.nvm}"
if [ -s "$NVM_DIR/nvm.sh" ]; then
    set +e
    . "$NVM_DIR/nvm.sh" > /dev/null 2>&1
    nvm use --silent > /dev/null 2>&1
    set -e
fi

# verify:push is PHASE-AWARE (scripts/verify-push.mjs reads scripts/gate-tiers.json):
# phase 0 (scaffold, pre-deploy) runs verify:scaffold:push and loudly SKIPS the stages that need a
# build — no prod boundary exists yet to guard; phase 1 (deployed) runs
# the full verify:ci chain, which is the same script CI runs, so a green pre-push keeps predicting a
# green pipeline. Pushing implies network, so the network-bound checks run in both phases.
# The stages of each chain are listed in scripts/gate-tiers.json (checks.<name>.chain).
# GATE_PHASE=full forces the full chain for one run.
echo "→ verify:push (phase-aware gate — see scripts/gate-tiers.json)"
npm run verify:push || {
    echo "❌ verify:push failed. Fix before push."
    echo "   Lint or formatting: npm run fix && git add -u"
    echo "   Playwright browsers are installed by scripts/ensure-playwright.mjs"
    echo "   Port 4173 busy? The gate clears its own stray; a foreign server means: move that lane."
    exit 1
}
