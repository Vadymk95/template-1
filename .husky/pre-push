# Optional nvm version switch (.nvmrc). Fenced with set +e: husky runs hooks
# under `sh -e`, and nvm re-arms errexit internally before returning non-zero —
# without the fence a missing nvm version kills the hook before its real work.
export NVM_DIR="${NVM_DIR:-$HOME/.nvm}"
if [ -s "$NVM_DIR/nvm.sh" ]; then
    set +e
    . "$NVM_DIR/nvm.sh" > /dev/null 2>&1
    nvm use --silent > /dev/null 2>&1
    set -e
fi

# verify:ci, not verify — pushing implies network, so the audit gate can run here.
# If this hook ran only `verify`, a green pre-push would stop predicting a green CI,
# which is the whole property the gate exists to hold.
echo "→ verify:ci (audit gate → types → lint → format → coverage → build → size → e2e)"
npm run verify:ci || {
    echo "❌ verify:ci failed. Fix before push."
    echo "   Lint or formatting: npm run fix && git add -u"
    echo "   Playwright browsers are installed by scripts/ensure-playwright.mjs"
    exit 1
}
