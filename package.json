{
    "name": "react-enterprise-foundation",
    "private": true,
    "version": "3.1.0",
    "type": "module",
    "engines": {
        "node": ">=24.0.0",
        "npm": ">=10.0.0"
    },
    "scripts": {
        "dev": "vite",
        "build": "tsc -b && vite build",
        "build:analyze": "ANALYZE=true npm run build",
        "verify:web-vitals-chunks": "node scripts/check-web-vitals-chunks.mjs",
        "verify:web-vitals-chunks:full": "node scripts/check-web-vitals-chunks.mjs --full",
        "size:check": "size-limit",
        "typecheck": "tsc -b",
        "lint": "eslint . --max-warnings 0",
        "lint:oxlint": "oxlint --config .oxlintrc.json --deny-warnings .",
        "fix": "oxlint --config .oxlintrc.json --fix . && eslint . --fix && prettier --write .",
        "format": "prettier --write .",
        "format:check": "prettier --check .",
        "lint:staged": "lint-staged",
        "audit:gate": "node scripts/audit-gate.mjs",
        "verify": "node scripts/check-hooks.mjs && npm run typecheck && npm run lint:oxlint && npm run lint && npm run format:check && npm run test:coverage && npm run build && npm run verify:web-vitals-chunks && npm run size:check && node scripts/ensure-playwright.mjs && npm run test:e2e:prod",
        "verify:ci": "npm run audit:gate && npm run verify",
        "smoke:dev": "playwright test --config playwright.dev.config.ts",
        "verify:full": "npm run verify:ci && npm run smoke:dev",
        "ci:local": "npm run verify:ci",
        "bench:verify": "node scripts/bench-verify.mjs",
        "test": "vitest run",
        "test:watch": "vitest",
        "test:coverage": "node scripts/check-coverage.mjs",
        "test:mutation": "stryker run",
        "test:coverage:raw": "vitest run --coverage",
        "test:e2e": "playwright test",
        "test:e2e:ui": "playwright test --ui",
        "preview": "vite preview",
        "prepare": "husky",
        "test:e2e:prod": "PLAYWRIGHT_USE_PREVIEW=1 playwright test"
    },
    "dependencies": {
        "@hookform/resolvers": "^5.4.0",
        "@radix-ui/react-slot": "^1.3.0",
        "@t3-oss/env-core": "^0.13.11",
        "@tanstack/react-query": "^5.101.2",
        "class-variance-authority": "^0.7.1",
        "clsx": "^2.1.1",
        "i18next": "^26.3.6",
        "i18next-browser-languagedetector": "^8.2.1",
        "i18next-http-backend": "^4.0.0",
        "lucide-react": "^1.24.0",
        "react": "^19.2.7",
        "react-dom": "^19.2.7",
        "react-hook-form": "^7.81.0",
        "react-i18next": "^17.0.10",
        "react-router-dom": "^7.18.1",
        "tailwind-merge": "^3.6.0",
        "tw-animate-css": "^1.4.0",
        "web-vitals": "^6.0.0",
        "zod": "^4.4.3",
        "zustand": "^5.0.14"
    },
    "devDependencies": {
        "@commitlint/cli": "^21.2.1",
        "@commitlint/config-conventional": "^21.2.0",
        "@eslint/js": "^10.0.1",
        "@playwright/test": "^1.62.1",
        "@size-limit/preset-app": "^13.0.3",
        "@stryker-mutator/core": "^9.6.1",
        "@stryker-mutator/vitest-runner": "^9.6.1",
        "@tailwindcss/vite": "^4.3.3",
        "@tanstack/eslint-plugin-query": "^5.101.2",
        "@testing-library/jest-dom": "^7.0.0",
        "@testing-library/react": "^16.3.2",
        "@testing-library/user-event": "^14.6.1",
        "@types/node": "^26.1.2",
        "@types/react": "^19.2.18",
        "@types/react-dom": "^19.2.4",
        "@vitejs/plugin-react": "^6.0.5",
        "@vitest/coverage-v8": "^4.1.10",
        "eslint": "^10.8.0",
        "eslint-config-prettier": "^10.1.8",
        "eslint-import-resolver-typescript": "^4.4.5",
        "eslint-plugin-better-tailwindcss": "^4.7.0",
        "eslint-plugin-i18next": "^6.1.5",
        "eslint-plugin-import-x": "^4.17.1",
        "eslint-plugin-jsx-a11y": "^6.10.2",
        "eslint-plugin-oxlint": "^1.76.0",
        "eslint-plugin-prettier": "^5.5.6",
        "eslint-plugin-react": "^7.37.5",
        "eslint-plugin-react-hooks": "^7.1.1",
        "eslint-plugin-react-refresh": "^0.5.3",
        "eslint-plugin-tailwindcss": "^4.2.0",
        "globals": "^17.9.0",
        "husky": "^9.1.7",
        "jsdom": "^29.1.1",
        "lint-staged": "^17.3.0",
        "msw": "^2.15.0",
        "oxlint": "~1.76.0",
        "prettier": "^3.9.5",
        "rollup-plugin-visualizer": "^7.0.1",
        "size-limit": "^13.0.1",
        "tailwindcss": "^4.3.3",
        "typescript": "~6.0.3",
        "typescript-eslint": "^8.64.0",
        "vite": "^8.2.0",
        "vite-plugin-compression": "^0.5.1",
        "vite-plugin-webfont-dl": "^3.12.0",
        "vitest": "^4.1.10"
    },
    "overrides": {
        "brace-expansion": ">=5.0.9 <6",
        "fast-uri": ">=4.1.2 <5",
        "eslint-plugin-react": {
            "eslint": "$eslint"
        },
        "eslint-plugin-jsx-a11y": {
            "eslint": "$eslint"
        },
        "eslint-plugin-import": {
            "eslint": "$eslint"
        },
        "js-yaml": ">=4.3.1 <5",
        "undici": ">=7.29.0 <8",
        "estimo": {
            "nanoid": ">=5.1.16 <6"
        },
        "postcss": {
            "nanoid": ">=3.3.17 <4"
        }
    },
    "lint-staged": {
        "*.{ts,tsx,js,jsx}": [
            "oxlint --config .oxlintrc.json --fix",
            "eslint --fix",
            "prettier --write"
        ],
        "*.{json,md,yml,yaml}": [
            "prettier --write"
        ]
    }
}
