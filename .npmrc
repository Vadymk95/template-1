# Lifecycle scripts are disabled repo-wide: install-script malware is the
# primary npm supply-chain vector (npm v12 skips them by default; this covers
# npm 10/11 users too). After cloning, install git hooks once with:
#   npm run prepare
ignore-scripts=true

# Refuse to install under a Node older than `engines.node`. Without this the
# engines field is advisory and a wrong local Node only surfaces as confusing
# runtime errors.
engine-strict=true

# The funding footer is noise in CI logs and in agent output.
fund=false

# Floor for a bare `npm audit`. The blocking gate is `npm run audit:gate`, which
# fails closed on high/critical and on its own inability to complete; this key
# only aligns the ad-hoc command with that policy, so a bare `npm audit` does not
# report a severity the gate will not block.
audit-level=high

# Resolve only package versions released >=3 days ago (npm 11.10+; value is in
# DAYS — pnpm's equivalent uses minutes, don't copy values across). Older npm
# warns and ignores the key. Urgent patch or brand-new package:
#   npm install <pkg> --min-release-age=0
min-release-age=3
